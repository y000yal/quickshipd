{
	"name": "y0000el/quickshipd",
	"description": "Estimated delivery dates for WooCommerce.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"scripts": {
		"test:unit": "phpunit -c phpunit-unit.xml.dist",
		"test:integration": "phpunit -c phpunit.xml.dist",
		"test": [
			"@test:unit",
			"@test:integration"
		]
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
